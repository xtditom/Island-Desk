<Window x:Class="IslandDesk.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:IslandDesk.Controls" xmlns:views="clr-namespace:IslandDesk.Views"
 Title="IslandDesk" Width="106" Height="36" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 ShowActivated="False" Focusable="False" FontFamily="Segoe UI" UseLayoutRounding="True"
 TextOptions.TextFormattingMode="Display" SizeChanged="Window_SizeChanged" AllowDrop="True"
 PreviewDragEnter="ShelfDrag_Enter" PreviewDragOver="ShelfDrag_Over" PreviewDragLeave="ShelfDrag_Leave" PreviewDrop="ShelfDrag_Drop">
    <Grid>
    <ui:IslandShadow x:Name="IslandShadow" Color="{DynamicResource IslandShadowColor}"/>
    <ui:IslandSurface x:Name="IslandSurface" CornerRadius="18" BorderThickness="1" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
        <Border.Style><Style TargetType="Border">
            <!-- Alpha belongs to the surface brush; content remains fully opaque. -->
            <Setter Property="Background" Value="{DynamicResource CollapsedSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SurfaceHoverBorder}"/></Trigger>
                <DataTrigger Binding="{Binding IsPressed, ElementName=PillButton}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SurfacePressedBorder}"/></DataTrigger>
            </Style.Triggers>
        </Style></Border.Style>
        <Grid ClipToBounds="True">
            <Button x:Name="PillButton" Click="PillButton_Click" Width="258" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Cursor="Hand" Focusable="False" IsTabStop="False" AutomationProperties.Name="Expand IslandDesk">
                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                <Button.RenderTransform><TranslateTransform x:Name="PillTranslation"/></Button.RenderTransform>
                <Grid Background="Transparent">
                    <StackPanel x:Name="ClockPill" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:PetIcon Width="19" Height="19" Margin="0,0,9,0"/>
                        <ui:ClockDisplay Text="{Binding Clock.Time}" FontSize="13" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="MusicPill" Width="234" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Hidden" DataContext="{Binding Media}">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CollapsedArtworkColumn" Width="24"/><ColumnDefinition x:Name="CollapsedArtworkGap" Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EqualizerGap" Width="12"/><ColumnDefinition x:Name="EqualizerColumn" Width="20"/></Grid.ColumnDefinitions>
                        <ui:MediaArtwork x:Name="CollapsedArtwork" Width="24" Height="24" Source="{Binding Artwork}" Radius="6"/>
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                        <ui:Equalizer x:Name="MusicEqualizer" Grid.Column="4"/>
                    </Grid>
                </Grid>
            </Button>
            <!-- Fixed layout width avoids text reflow during the simultaneous window morph. -->
            <Grid x:Name="ExpandedContent" Width="370" Height="364" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                <Grid.RenderTransform><TranslateTransform x:Name="ContentTranslation" Y="-5"/></Grid.RenderTransform>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ui:IslandHeader x:Name="Header"/>
                <views:MainDashboard x:Name="MainDashboard" Grid.Row="2" Height="242" VerticalAlignment="Top"/>
                <views:SystemDashboard x:Name="SystemDashboard" Grid.Row="2" Height="316" VerticalAlignment="Top" Visibility="Hidden"/>
                <views:QuickControlsDashboard x:Name="QuickControlsDashboard" Grid.Row="2" VerticalAlignment="Top" Visibility="Hidden"/>
                <views:FileShelfDashboard x:Name="FileShelfDashboard" Grid.Row="2" VerticalAlignment="Top" Visibility="Hidden"/>
            </Grid>
        </Grid>
    </ui:IslandSurface>
    </Grid>
</Window>

