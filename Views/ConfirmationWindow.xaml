<Window x:Class="IslandDesk.Views.ConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" ShowActivated="True"
 Background="{DynamicResource SettingsSurface}" Foreground="{DynamicResource Primary}" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="14"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary Source="../Themes/SettingsTheme.xaml"/></Window.Resources>
 <Border BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel>
   <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <TextBlock x:Name="Message" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
    <Button x:Name="CancelButton" Content="Cancel" MinWidth="74" IsCancel="True"/>
    <Button x:Name="ConfirmButton" Content="Confirm" MinWidth="86" Background="{DynamicResource ControlSelected}" Margin="8,0,0,0" Click="Confirm_Click"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
