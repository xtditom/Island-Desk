<UserControl x:Class="IslandDesk.Views.QuickControlsDashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:IslandDesk.Controls" xmlns:local="clr-namespace:IslandDesk.Views" x:Name="Root" Focusable="False" Height="314">
    <UserControl.Resources>
        <Style x:Key="UtilityCard" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="70"/>
            <Setter Property="Background" Value="{Binding CardBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:IslandSurface}}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="local:QuickControlsDashboard.IsDragSource" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Secondary}"/><Setter Property="Opacity" Value="0.6"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="local:QuickControlsDashboard.IsActive" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Secondary}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    <Trigger Property="local:QuickControlsDashboard.IsDropTarget" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="226"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Quick Controls" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Margin="2,0,0,0"/>
        <Border x:Name="DragPreview" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5" Padding="5,1" Background="{DynamicResource ControlSelected}" BorderBrush="{DynamicResource Secondary}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="DragPreviewLabel" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Primary}"/>
        </Border>
        <ui:PagedActionGrid x:Name="Actions" Grid.Row="1">
            <ui:PagedActionGrid.RenderTransform><TranslateTransform x:Name="PageOffset"/></ui:PagedActionGrid.RenderTransform>
            <Button x:Name="ScreenshotButton" Tag="Screenshot" Grid.Column="0" Grid.Row="0" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Screenshot">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,6 L1,1 6,1 M14,1 L19,1 19,6 M19,14 L19,19 14,19 M6,19 L1,19 1,14 M5,5 L15,5 15,15 5,15 Z"/>
                    <TextBlock Text="Screenshot" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClipboardButton" Tag="ClipboardHistory" Grid.Column="2" Grid.Row="0" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Clipboard History">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,3 L3,3 3,19 17,19 17,3 13,3 M7,1 L13,1 13,5 7,5 Z M6,9 L14,9 M6,13 L14,13"/>
                    <TextBlock Text="Clipboard History" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="TaskManagerButton" Tag="TaskManager" Grid.Column="4" Grid.Row="0" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Task Manager">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L18,2 18,18 2,18 Z M5,13 L8,9 11,12 15,6"/>
                    <TextBlock Text="Task Manager" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="SearchButton" Tag="Search" Grid.Column="0" Grid.Row="2" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Windows Search">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,1 A7,7 0 1 1 8,15 A7,7 0 1 1 8,1 M13,13 L19,19"/>
                    <TextBlock Text="Windows Search" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="LockButton" Tag="Lock" Grid.Column="2" Grid.Row="2" Style="{StaticResource UtilityCard}" Click="Lock_Click" AutomationProperties.Name="Lock Device">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,9 L16,9 16,19 4,19 Z M6,9 L6,5 A4,4 0 0 1 14,5 L14,9 M10,12 L10,15"/>
                    <TextBlock Text="Lock Device" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="EmojiButton" Tag="Emoji" Grid.Column="4" Grid.Row="2" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Emoji Panel">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,1 A9,9 0 1 1 10,19 A9,9 0 1 1 10,1 M6,6 L6,8 M14,6 L14,8 M5,12 Q10,18 15,12"/>
                    <TextBlock Text="Emoji Panel" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="AwakeButton" Tag="KeepAwake" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Keep PC Awake" ToolTip="Prevent automatic sleep; manual sleep remains available.">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M2,3 L16,3 16,14 2,14 Z M6,18 L12,18 M9,14 L9,18 M6,7 L12,7 M6,10 L12,10"/>
                    <TextBlock x:Name="AwakeLabel" Text="Keep PC Awake · Off" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="EmptyRecycleBin" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Empty Recycle Bin">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M2,5 L18,5 M7,5 L7,2 13,2 13,5 M4,5 L5,19 15,19 16,5 M8,8 L8,16 M12,8 L12,16"/>
                    <TextBlock Text="Empty Recycle Bin" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="OnScreenKeyboard" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="On-Screen Keyboard">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M1,4 L19,4 19,16 1,16 Z M4,7 L5,7 M8,7 L9,7 M12,7 L13,7 M16,7 L17,7 M4,10 L5,10 M8,10 L9,10 M12,10 L13,10 M16,10 L17,10 M5,13 L15,13"/>
                    <TextBlock Text="On-Screen Keyboard" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="MicrophoneButton" Tag="Microphone" IsEnabled="False" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Microphone mute or unmute">
                <StackPanel><Grid Width="19" Height="19"><Path Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M7,4 A3,3 0 0 1 13,4 L13,10 A3,3 0 0 1 7,10 Z M4,8 L4,10 A6,6 0 0 0 16,10 L16,8 M10,16 L10,19 M6,19 L14,19"/>
                    <Path x:Name="MicrophoneSlash" Visibility="Hidden" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" Data="M1,1 L18,18"/></Grid>
                    <TextBlock x:Name="MicrophoneLabel" Text="Microphone · Checking" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="ShowDesktop" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Show Desktop" ToolTip="Show or restore desktop windows (Win+D).">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M1,2 L19,2 19,15 1,15 Z M7,19 L13,19 M10,15 L10,19 M4,5 L10,5 10,10 4,10 Z"/>
                    <TextBlock Text="Show Desktop" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="SignOut" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Sign Out">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M9,2 L2,2 2,18 9,18 M7,10 L19,10 M14,5 L19,10 14,15"/>
                    <TextBlock Text="Sign Out" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="DisplayOff" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Turn Off Display" ToolTip="Turn off displays without putting Windows to sleep.">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" Data="M2,3 L18,3 18,15 2,15 Z M7,19 L13,19 M10,15 L10,19 M6,6 L14,12 M14,6 L6,12"/>
                    <TextBlock Text="Turn Off Display" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="WifiButton" Tag="Wifi" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Wi-Fi">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,5 Q10,-2 19,5 M4,9 Q10,4 16,9 M7,13 Q10,10 13,13 M9,17 L11,17"/>
                    <TextBlock x:Name="WifiLabel" Text="Wi-Fi · Checking" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BluetoothButton" Tag="Bluetooth" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Bluetooth">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M5,5 L15,15 10,20 10,0 15,5 5,15"/>
                    <TextBlock x:Name="BluetoothLabel" Text="Bluetooth · Checking" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="TaskView" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Task View">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M5,3 L15,3 15,17 5,17 Z M1,5 L1,15 M19,5 L19,15"/>
                    <TextBlock Text="Task View" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="Run" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Run Dialog">
                <StackPanel><Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M1,3 L19,3 19,17 1,17 Z M1,7 L19,7 M5,10 L8,12 5,14 M11,14 L15,14"/>
                    <TextBlock Text="Run Dialog" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,7,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BrightnessButton" Tag="Brightness" Style="{StaticResource UtilityCard}" Click="Utility_Click" AutomationProperties.Name="Screen Brightness">
                <StackPanel><Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M10,5 A5,5 0 1 1 10,15 A5,5 0 1 1 10,5 M10,0 L10,2 M10,18 L10,20 M0,10 L2,10 M18,10 L20,10 M3,3 L4,4 M16,16 L17,17 M3,17 L4,16 M16,4 L17,3"/>
                    <TextBlock x:Name="BrightnessLabel" Text="Brightness · Checking" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Primary}" Margin="0,4,0,0"/>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Height="16" Width="88" Visibility="Collapsed" IsEnabled="False" Focusable="False" IsTabStop="False" ValueChanged="Brightness_ValueChanged" AutomationProperties.Name="Screen brightness" ToolTip="Hardware brightness"/>
                </StackPanel>
            </Button>
        </ui:PagedActionGrid>
        <Canvas Grid.Row="1" IsHitTestVisible="False"><Border x:Name="InsertionMarker" Width="2" Height="64" CornerRadius="1" Background="{DynamicResource Primary}" Visibility="Collapsed"/></Canvas>
        <StackPanel x:Name="Pagination" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="PreviousPage" Style="{StaticResource ControlButton}" Width="24" Height="22" Click="Previous_Click" ToolTip="Previous page" AutomationProperties.Name="Previous Quick Controls page"><Path Data="M5,0 L0,5 5,10" Stroke="{DynamicResource Secondary}" StrokeThickness="1.2"/></Button>
            <StackPanel x:Name="PageIndicators" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="NextPage" Style="{StaticResource ControlButton}" Width="24" Height="22" Click="Next_Click" ToolTip="Next page" AutomationProperties.Name="Next Quick Controls page"><Path Data="M0,0 L5,5 0,10" Stroke="{DynamicResource Secondary}" StrokeThickness="1.2"/></Button>
        </StackPanel>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Text="Drag cards to rearrange; right-click for layout options." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="3,2,3,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button x:Name="HardwareSettingsLink" Grid.Column="1" Style="{StaticResource ControlButton}" Width="Auto" Height="24" Padding="4,0" FontSize="9" Visibility="Collapsed" Click="HardwareSettings_Click"/>
        </Grid>
    </Grid>
</UserControl>
