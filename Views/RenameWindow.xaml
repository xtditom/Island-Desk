<Window x:Class="IslandDesk.Views.RenameWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Rename IslandDesk" Width="320" Height="190" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources><ResourceDictionary Source="../Themes/SettingsTheme.xaml"/></Window.Resources>
    <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="18" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Make it yours" Foreground="{DynamicResource Primary}" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="TitleInput" Grid.Row="1" Margin="0,14,0,0" Padding="9,7" Background="{DynamicResource InputSurface}" Foreground="{DynamicResource Primary}" CaretBrush="{DynamicResource Primary}"
                     BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" FontSize="13" TextChanged="TitleInput_TextChanged"/>
            <TextBlock x:Name="Feedback" Grid.Row="2" Text="Up to 20 characters" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Width="65" Content="Cancel" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Width="65" Content="Save" Background="{DynamicResource ControlEmphasis}" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

