<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.3.0</Version>
    <Product>IslandDesk</Product>
    <Company>IslandDesk</Company>
    <Description>A lightweight Windows desktop island.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist\**;.tools\**;tests\**</DefaultItemExcludes>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon Condition="Exists('Assets\IslandDesk.ico')">Assets\IslandDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <None Update="IslandDesk.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Remove="Assets\IslandDesk.ico" />
    <Resource Include="Assets\IslandDesk.ico" Condition="Exists('Assets\IslandDesk.ico')" />
  </ItemGroup>

</Project>
