<UserControl x:Class="IslandDesk.Controls.MediaPlayerCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:IslandDesk.Controls" Focusable="False">
 <Border x:Name="PlayerCard" Style="{StaticResource Card}">
 <Grid x:Name="Layout">
  <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition x:Name="TimelineRow" Height="40"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ControlsColumn" Width="108"/></Grid.ColumnDefinitions>
   <Border x:Name="InformationCard" Background="Transparent" Padding="11" MouseLeftButtonUp="Card_MouseLeftButtonUp" Cursor="Hand">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:MediaArtwork x:Name="AlbumArtwork" Source="{Binding Artwork}" Width="56" Height="56" VerticalAlignment="Center" Radius="9"/>
     <StackPanel x:Name="Metadata" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
      <TextBlock x:Name="ArtistText" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" FontSize="10.5" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0"/>
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border x:Name="TransportCard" Grid.Column="1" Background="Transparent" Padding="5">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Button Style="{StaticResource ControlButton}" Command="{Binding PreviousCommand}" ToolTip="Previous track" AutomationProperties.Name="Previous track"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE892;"/></Button>
     <Button Style="{StaticResource ControlButton}" Command="{Binding ToggleCommand}" Background="{DynamicResource ControlEmphasis}" Margin="3,0" ToolTip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="{Binding ToggleGlyph}"/></Button>
     <Button Style="{StaticResource ControlButton}" Command="{Binding NextCommand}" ToolTip="Next track" AutomationProperties.Name="Next track"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE893;"/></Button>
    </StackPanel>
   </Border>
  </Grid>
  <Border x:Name="TimelineDivider" Grid.Row="1" Height="1" VerticalAlignment="Top" Margin="12,0" Background="{DynamicResource CardBorder}" IsHitTestVisible="False"/>
  <ui:PlaybackTimeline x:Name="Timeline" Grid.Row="1" DataContext="{Binding Timeline}"/>
 </Grid>
 </Border>
</UserControl>

