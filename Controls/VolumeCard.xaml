<UserControl x:Class="IslandDesk.Controls.VolumeCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:IslandDesk.Controls" Focusable="False">
    <Border Style="{StaticResource Card}" Padding="10,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource ControlButton}" Command="{Binding MuteCommand}" ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="{Binding MuteGlyph}"/>
            </Button>
            <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Margin="12,0" Style="{StaticResource VolumeSlider}" IsEnabled="{Binding IsAvailable}"
                    Foreground="{DynamicResource VolumeFill}" Background="{DynamicResource VolumeTrack}" ui:SliderAppearance.ThumbBrush="{DynamicResource VolumeThumb}"
                    Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Master volume"/>
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Foreground="{DynamicResource Secondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>

