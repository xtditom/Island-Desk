<UserControl x:Class="IslandDesk.Controls.IslandHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
    <UserControl.Resources>
        <Geometry x:Key="HomeIcon">M1,8 L8,2 15,8 M3,7 L3,15 6,15 6,10 10,10 10,15 13,15 13,7</Geometry>
        <Geometry x:Key="SystemIcon">M4,4 L14,4 14,14 4,14 Z M7,7 L11,7 11,11 7,11 Z M6,1 L6,4 M9,1 L9,4 M12,1 L12,4 M6,14 L6,17 M9,14 L9,17 M12,14 L12,17 M1,6 L4,6 M1,9 L4,9 M1,12 L4,12 M14,6 L17,6 M14,9 L17,9 M14,12 L17,12</Geometry>
        <Geometry x:Key="QuickControlsIcon">M1,4 L15,4 M1,12 L15,12 M5,1 L5,7 M11,9 L11,15</Geometry>
        <Geometry x:Key="FileShelfIcon">M2,1 L10,1 14,5 14,15 2,15 Z M10,1 L10,5 14,5 M5,8 L11,8 M5,11 L11,11</Geometry>
        <Style x:Key="NavigationItem" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="28"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="HeaderRoot" Background="Transparent" Grid.IsSharedSizeScope="True" Margin="2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderSide"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderSide"/>
        </Grid.ColumnDefinitions>
        <!-- Original header side width; the navigation overlay is measured separately. -->
        <Grid Width="98" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="HomeTab" Width="34" Height="30" HorizontalAlignment="Left"
                    Style="{StaticResource ControlButton}" Background="{DynamicResource ControlSelected}"
                    ToolTip="Choose dashboard" AutomationProperties.Name="Choose dashboard"
                    MouseEnter="Home_MouseEnter" MouseLeave="Navigation_MouseLeave" Click="Home_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="PrimaryIcon" Data="{StaticResource HomeIcon}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource Secondary}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    <Path Data="M0,0 L3,3 0,6" Width="3" Height="6" Margin="4,0,0,0" Stretch="Uniform"
                          Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource ControlButton}" Width="30" Height="30"
                    HorizontalAlignment="Left" Margin="38,0,0,0" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </Button>

        </Grid>
        <Button x:Name="MainTab" Grid.Column="1" Style="{StaticResource ControlButton}" Width="Auto" Height="30" Margin="3,0" Padding="6,0" HorizontalAlignment="Stretch"
                ToolTip="Click to rename" AutomationProperties.Name="Rename island" Click="Title_Click">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/>
        </Button>
        <!-- Hidden content still participates in measurement, keeping both tabs stable.
             Equal Auto side columns keep the customizable title centered. -->
        <Grid Grid.Column="2" Height="40" HorizontalAlignment="Right">
        <StackPanel x:Name="HomeDate" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding IsHome}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
            </Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="{Binding Clock.Weekday}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource Primary}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Clock.Date}" FontSize="10" Foreground="{DynamicResource Primary}" Opacity="0.78" Margin="0,3,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
        <TextBlock x:Name="SystemClock" Text="{Binding Clock.Time}" FontSize="16" FontWeight="Medium"
                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Primary}"
                   HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Hidden"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
        </Grid>
        <!-- Canvas measures to zero: the strip can cover title/Settings without reserving space. -->
        <Canvas Grid.ColumnSpan="3" Panel.ZIndex="20">
            <Grid x:Name="NavigationViewport" Width="108" Height="32" Canvas.Left="36" Canvas.Top="4"
                  Visibility="Hidden" Background="Transparent" MouseEnter="Navigation_MouseEnter" MouseLeave="Navigation_MouseLeave">
                <Grid.Clip><RectangleGeometry Rect="0,0,108,32"/></Grid.Clip>
                <Border x:Name="NavigationRegion" Padding="1" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PopupBorder}">
                    <Border.RenderTransform><TranslateTransform x:Name="NavigationOffset" X="-108"/></Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HomeItem" Tag="Main" MouseEnter="NavigationItem_MouseEnter" Click="NavigationItem_Click" ToolTip="Home" AutomationProperties.Name="Home">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationItem}"><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlSelected}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Path Data="{StaticResource HomeIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="SystemTab" Tag="System" MouseEnter="NavigationItem_MouseEnter" Click="NavigationItem_Click" ToolTip="System" AutomationProperties.Name="System">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationItem}"><Style.Triggers><DataTrigger Binding="{Binding IsSystem}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlSelected}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Path Data="{StaticResource SystemIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="QuickControlsItem" Tag="QuickControls" MouseEnter="NavigationItem_MouseEnter" Click="NavigationItem_Click" ToolTip="Quick Controls" AutomationProperties.Name="Quick Controls">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationItem}"><Style.Triggers><DataTrigger Binding="{Binding IsQuickControls}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlSelected}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Path Data="{StaticResource QuickControlsIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="FileShelfItem" Tag="FileShelf" MouseEnter="NavigationItem_MouseEnter" Click="NavigationItem_Click" ToolTip="File Shelf" AutomationProperties.Name="File Shelf">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationItem}"><Style.Triggers><DataTrigger Binding="{Binding IsFileShelf}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlSelected}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Path Data="{StaticResource FileShelfIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
