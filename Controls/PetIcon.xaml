<UserControl x:Class="IslandDesk.Controls.PetIcon"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" IsHitTestVisible="False">
    <!-- Pip: an original little round-eared desk companion, drawn in six simple shapes. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Fill="{DynamicResource PetFace}" Data="M 4,9 C 1,3 7,2 9,6 C 11,5 13,5 15,6 C 18,2 23,4 20,10 C 23,17 19,21 12,21 C 5,21 1,17 4,9 Z"/>
            <Ellipse Width="2" Height="2.6" Fill="{DynamicResource PetDetail}" Canvas.Left="7" Canvas.Top="11"/>
            <Ellipse Width="2" Height="2.6" Fill="{DynamicResource PetDetail}" Canvas.Left="15" Canvas.Top="11"/>
            <Path Stroke="{DynamicResource PetDetail}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 10,16 Q 12,18 14,16"/>
            <Ellipse Width="3" Height="1.5" Fill="{DynamicResource PetCheek}" Canvas.Left="4.5" Canvas.Top="15"/>
            <Ellipse Width="3" Height="1.5" Fill="{DynamicResource PetCheek}" Canvas.Left="16.5" Canvas.Top="15"/>
        </Canvas>
    </Viewbox>
</UserControl>

