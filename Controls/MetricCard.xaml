<UserControl x:Class="IslandDesk.Controls.MetricCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Card" Focusable="False">
    <Border Style="{StaticResource Card}" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Label, ElementName=Card}" ToolTip="{Binding Label, ElementName=Card}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Secondary}" FontSize="10" FontWeight="Medium"/>
            <TextBlock Grid.Row="1" Text="{Binding Value, ElementName=Card}" Foreground="{DynamicResource Primary}" FontSize="23" FontWeight="Medium" VerticalAlignment="Center"/>
            <ProgressBar Grid.Row="2" Style="{StaticResource UsageBar}" Value="{Binding Progress, ElementName=Card, Mode=OneWay}" AutomationProperties.Name="{Binding Label, ElementName=Card}"/>
            <TextBlock Grid.Row="3" Text="{Binding Detail, ElementName=Card}" ToolTip="{Binding Detail, ElementName=Card}"
                       Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding Detail, ElementName=Card}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>

